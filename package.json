{
  "name": "kit-transit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kit Transit — two-institution library-kit custody on a Gno realm",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "indexer": "node src/indexer.ts --daemon",
    "api": "node src/api.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "stack:up": "scripts/dev-stack.sh up",
    "stack:down": "scripts/dev-stack.sh down",
    "e2e": "scripts/e2e-local.sh",
    "reindex": "node src/reindex.ts"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10"
  }
}
